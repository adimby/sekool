# Variables lues par Docker Compose (copier vers .env à la racine du dépôt).
# Ne pas confondre avec api/.env (Laravel en local).

# URL publique de FANABE (IP du VPS ou domaine). Obligatoire hors localhost.
APP_URL=http://127.0.0.1

# Port HTTP publié par `make vps` (80 si libre, sinon 8080).
FANABE_HTTP_PORT=80

# Ports hôte pour `make up` uniquement (Laravel tourne sur la machine).
FANABE_PG_PORT=5432
FANABE_REDIS_PORT=16379
FANABE_MINIO_API_PORT=9000
FANABE_MINIO_CONSOLE_PORT=9001
FANABE_MAIL_SMTP_PORT=1025
FANABE_MAIL_UI_PORT=8025

# Optionnel : coller une clé Laravel pour figer les sessions entre rebuilds.
# Sinon elle est générée et persistée dans le volume Docker fanabe_keys.
# APP_KEY=
