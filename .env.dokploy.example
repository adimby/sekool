# Coller dans l'onglet Environment de Dokploy (Compose).
# APP_URL = le domaine HTTPS que vous attachez au service `app`.

APP_URL=https://sekool.ivonea.com
APP_DEBUG=false
APP_KEY=base64:

# Compte Laravel → Postgres (fixe, créé au premier démarrage du volume) :
#   utilisateur fanabe / mot de passe fanabe
# Vous n'avez PAS à choisir un mot de passe « Docker Postgres » pour l'app.
DATABASE_URL=postgres://fanabe:fanabe@db:5432/fanabe

# Optionnel : superuser interne `postgres` (défaut : postgres). Laravel ne l'utilise pas.
POSTGRES_SUPERUSER_PASSWORD=postgres
